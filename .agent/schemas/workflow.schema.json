{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arena-agent-pack.invalid/schemas/workflow.schema.json",
  "title": "HARĒNA Composable Workflow",
  "type": "object",
  "required": ["workflow_id", "version", "steps"],
  "properties": {
    "workflow_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "skill"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "skill": {"type": "string"},
          "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "tools": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "inputs": {"type": "array", "items": {"type": "string"}},
          "outputs": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
