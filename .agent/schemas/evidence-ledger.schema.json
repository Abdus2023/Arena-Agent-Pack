{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arena-agent-pack.invalid/schemas/evidence-ledger.schema.json",
  "title": "HARĒNA Evidence Ledger",
  "type": "object",
  "required": ["schema_version", "sources", "claims"],
  "properties": {
    "schema_version": {"type": "string"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "uri"],
        "properties": {
          "id": {"type": "string"},
          "uri": {"type": "string", "minLength": 1},
          "revision": {"type": ["string", "null"]},
          "retrieved_at": {"type": ["string", "null"]},
          "source_type": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "claim_status", "verification_status", "source_ids", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "statement": {"type": "string", "minLength": 1},
          "claim_status": {"enum": ["PROVED", "ARGUMENT", "CONJECTURE", "OPEN"]},
          "verification_status": {"enum": ["VERIFIED", "PARTIALLY_VERIFIED", "PROVISIONAL", "BLOCKED"]},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
